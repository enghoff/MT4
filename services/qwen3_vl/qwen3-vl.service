[Unit]
Description=Qwen3-VL-4B-Instruct vision-language service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/qwen3-vl
Environment=QWEN_VL_HOST=127.0.0.1
Environment=QWEN_VL_PORT=8766
Environment=QWEN_VL_MODEL=Qwen/Qwen3-VL-4B-Instruct
Environment=QWEN_VL_DEVICE=cuda
Environment=QWEN_VL_LOAD_IN_4BIT=1
# Decode loop: torchao int4 weights + static KV cache + CUDA-graphed decode.
# 11.4 -> 45 tok/s, GPU utilization 48% -> 81%. Costs ~20s of compilation on top
# of a 4s load, so /health reports loaded:false for ~25s after a restart. No
# FORCE_COMPILE here: torchao passes transformers' compile gate on its own,
# unlike bitsandbytes. Set COMPILE=0 to revert to eager.
Environment=QWEN_VL_QUANT=int4
Environment=QWEN_VL_CACHE_LEN=1664
Environment=QWEN_VL_COMPILE=1
ExecStart=/opt/qwen3-vl/.venv/bin/python /opt/qwen3-vl/server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
